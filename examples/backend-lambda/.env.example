# Values for `cdk deploy`. Copy to .env (never commit it), load it in your shell and
# pass the values as CDK context, for example:
#
#   set -a; . ./.env; set +a
#   npm exec -- cdk deploy -c apiTokenSha256="$API_TOKEN_SHA256" -c confidenceThreshold="$CONFIDENCE_THRESHOLD"
#
# AWS credentials for the deployment come from your AWS CLI profile, not from this file.

# SHA-256 hex digest(s) of your bearer token(s), comma-separated. Never the token itself.
# Create a token and its digest:
#   node -e "const t=require('crypto').randomBytes(32).toString('base64url');console.log('token:',t);console.log('sha256:',require('crypto').createHash('sha256').update(t).digest('hex'))"
API_TOKEN_SHA256=

# FaceMovementChallenge (default) or FaceMovementAndLightChallenge.
CHALLENGE=FaceMovementChallenge
# Let the app choose the challenge (demo only).
ALLOW_CLIENT_CHALLENGE=false
# 0-4 audit images.
AUDIT_IMAGES_LIMIT=0
# Optional S3 output for reference/audit images.
OUTPUT_BUCKET_NAME=
OUTPUT_KEY_PREFIX=
# Minimum confidence (0-100) for isLive, decided server-side only.
CONFIDENCE_THRESHOLD=80
# Stage throttling (requests per second and burst).
RATE_LIMIT=10
BURST_LIMIT=20
