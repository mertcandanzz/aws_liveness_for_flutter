{
  "name": "aws-liveness-backend-lambda",
  "version": "0.1.0",
  "private": true,
  "description": "Serverless example backend for aws_liveness_for_flutter: HTTP API, a Lambda authorizer and three Lambdas, deployed with AWS CDK.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit false --outDir dist",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "synth": "tsx infra/synth-check.ts",
    "deploy": "cdk deploy"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1152.0",
    "@aws-sdk/client-rekognition": "^3.1152.0",
    "@aws-sdk/client-sts": "^3.1152.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26.6.5",
    "aws-cdk": "^2.1145.0",
    "aws-cdk-lib": "^2.273.0",
    "aws-sdk-client-mock": "^4.1.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
