# Copy to .env (never commit it) and load it with your process manager, or
# export the variables in your shell. AWS credentials for this server come
# from the standard AWS provider chain, not from this file.

PORT=8787
AWS_REGION=eu-west-1

# Comma-separated bearer tokens, at least 32 characters each. Each token is a
# separate caller; sessions are bound to the caller that created them.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
LIVENESS_API_TOKENS=

# Role assumed for app credentials (scoped down to StartFaceLivenessSession).
LIVENESS_CREDENTIALS_ROLE_ARN=arn:aws:iam::<ACCOUNT_ID>:role/<LIVENESS_CLIENT_ROLE>

# FaceMovementChallenge (default) or FaceMovementAndLightChallenge.
LIVENESS_CHALLENGE=FaceMovementChallenge
# Let the app choose the challenge (demo only).
LIVENESS_ALLOW_CLIENT_CHALLENGE=false

# 0-4 audit images; 0 keeps no extra images.
LIVENESS_AUDIT_IMAGES_LIMIT=0
# Optional S3 output for reference/audit images.
LIVENESS_OUTPUT_S3_BUCKET=
LIVENESS_OUTPUT_S3_KEY_PREFIX=

# Minimum confidence (0-100) for isLive, decided on this server only.
LIVENESS_CONFIDENCE_THRESHOLD=80

LIVENESS_RATE_LIMIT_PER_MINUTE=30
