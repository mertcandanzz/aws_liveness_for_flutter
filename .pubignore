# pub uses this file INSTEAD of the root .gitignore, so the .gitignore rules
# are repeated here. Keep both files in sync.

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# Flutter/Dart/Pub related
/pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
/build/
/coverage/

# Local-only files. Never published.
/aws_liveness_for_flutter-baslangic-promptu.md
.vi3ecode/

# Secrets and local environment
.env
.env.*
!.env.example
*.pem
*.p12
*.jks
*.keystore
key.properties

# Backend examples (Node.js) live in the repository, not in the pub package:
# they are not Dart code, and pub expects the top-level "example" directory
# only (a top-level "examples" directory is a pub warning).
/examples/
